# ---------- Runtime ----------
NODE_ENV=development
PORT=4001
APP_NAME="Vision Valley School Management System"
CLIENT_ORIGIN=http://localhost:5174
TIMEZONE=Asia/Kolkata

# ---------- Database ----------
# Local dev cluster created by scripts/dev-db.sh (see README)
DATABASE_URL=postgresql://vvs@127.0.0.1:5434/vvs_db
DB_POOL_MAX=10

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=7
REMEMBER_ME_TTL_DAYS=30
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ---------- First admin (seed only) ----------
# No default admin exists in code. The seed script creates this account once.
ADMIN_EMAIL=principal@visionvalley.edu.in
ADMIN_NAME=Principal
ADMIN_INITIAL_PASSWORD=

# ---------- Demo data (never allowed in production) ----------
# Off for the real dev database. Tests use their own fixtures in vvs_test.
SEED_DEMO=false
DEMO_PASSWORD=

# ---------- File uploads ----------
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=5

# ---------- Cross-site deployment (two vercel.app projects) ----------
# lax (default) for same-site deploys; none for two different vercel.app domains.
# "none" requires HTTPS (production always sets secure).
COOKIE_SAMESITE=lax
